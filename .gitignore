*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
*.whl
dist/
build/
.Python
.python-version

# ── Virtual Environments ──────────────────────────
.venv/
venv/
env/

# ── UV (Python package manager) ───────────────────
uv.lock

