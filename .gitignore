# ═══════════════════════════════════════════════════
# Krishi-Sarthi .gitignore
# ═══════════════════════════════════════════════════

# ── Environment & Secrets ─────────────────────────
.env
.env.local
.env.production
backend/.env

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
*.whl
dist/
build/
.Python

# ── Virtual Environments ──────────────────────────
.venv/
venv/
env/
backend/.venv/

# ── Node.js / Frontend ───────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/
.npm
.yarn/
*.tsbuildinfo

# ── IDE / Editor ──────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Database Files ────────────────────────────────
*.db
*.sqlite3
*.sqlite3-journal
demo.db
krishi.db
krishi_demo.db

# ── AI Models (too large for git) ─────────────────
ai-service/models/*.pth
ai-service/models/*.pt
ai-service/models/*.bin
ai-service/models/*.onnx
ai-service/models/faiss_index/

# ── Uploads & Generated ──────────────────────────
uploads/
backend/uploads/
*.log

# ── Testing / Coverage ───────────────────────────
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/
coverage.xml

# ── Type Checkers ─────────────────────────────────
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# ── OS Files ──────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Misc ──────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/

# Raw datasets (too large for git)
ai-service/data/raw/
demo_assets/sample_images/
