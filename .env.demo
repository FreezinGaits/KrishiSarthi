# ═══════════════════════════════════════════════════
# Krishi-Sarthi Demo Environment
# Copy to backend/.env for hackathon demo
# ═══════════════════════════════════════════════════

APP_NAME=Krishi-Sarthi
ENVIRONMENT=demo
DEBUG=true

# Demo mode (uses mock AI responses, no GPU required)
DEMO_MODE=true
MOCK_AI_RESPONSES=true
MOCK_VENDOR_DATA=true

# Database (SQLite for demo — no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./demo.db

# API Security
API_KEY=demo-api-key-2026

# OpenAI (optional — works without in demo mode)
OPENAI_API_KEY=sk-demo-not-needed
OPENAI_MODEL=gpt-3.5-turbo

# n8n (optional — demo mode simulates workflows)
N8N_BASE_URL=http://localhost:5678
N8N_NOTIFICATION_WEBHOOK=/webhook/send-notification
N8N_ESCALATION_WEBHOOK=/webhook/escalation

# File uploads
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
